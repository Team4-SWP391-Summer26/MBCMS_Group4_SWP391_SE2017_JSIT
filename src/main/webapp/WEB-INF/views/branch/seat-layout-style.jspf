<%-- Shared seat-layout styles for /branch/seats and /admin/seats (mockup 25). --%>
<style>
    /* ----- Screen ----- */
    .sl-screen-wrap { position: relative; text-align: center; padding-top: 6px; }
    .sl-screen-curve {
        height: 30px; margin: 0 auto; max-width: 62%;
        border-top: 3px solid #93b4f6;
        border-radius: 50% / 100% 100% 0 0;
        box-shadow: 0 -10px 22px -10px rgba(37,99,235,.45);
    }
    .sl-screen-label {
        margin-top: -10px; font-size: .72rem; letter-spacing: .42em;
        color: var(--lc-muted); font-weight: 600;
    }

    /* ----- Grid ----- */
    .sl-grid { display: inline-flex; flex-direction: column; gap: 7px; width: 100%; align-items: center; }
    .sl-row { display: flex; align-items: center; gap: 7px; }
    .sl-rlabel { width: 18px; text-align: center; font-size: .72rem; font-weight: 700; color: var(--lc-muted); }
    .sl-aisle { width: 22px; }

    .sl-seat {
        width: 30px; height: 30px; border-radius: 7px; padding: 0;
        border: 1.5px solid #cdd6e6; background: #fff; cursor: pointer;
        transition: transform .1s ease, box-shadow .1s ease, background .1s ease;
    }
    .sl-seat:hover { transform: translateY(-1px); }
    .sl-seat.is-std { background: #fff; border-color: #cdd6e6; }
    .sl-seat.is-vip { background: #FFE08A; border-color: #f3c64b; }
    .sl-seat.is-off { background: #e2e8f0; border-color: #cbd5e1; opacity: .6; cursor: not-allowed; }
    .sl-seat.is-off:hover { transform: none; }
    .sl-seat.selected {
        box-shadow: 0 0 0 3px rgba(37,99,235,.35);
        border-color: var(--lc-primary);
    }

    /* ----- Toolbar ----- */
    .sl-tools { display: inline-flex; background: #eef1f4; border-radius: 10px; padding: 3px; gap: 2px; }
    .sl-tool {
        border: 0; background: transparent; font-size: .8rem; font-weight: 600;
        color: var(--lc-muted); padding: .32rem .7rem; border-radius: 8px; cursor: pointer;
        display: inline-flex; align-items: center; gap: .4rem; transition: all .12s ease;
    }
    .sl-tool.active { background: #fff; color: var(--lc-navy); box-shadow: 0 1px 2px rgba(15,30,54,.14); }

    /* ----- Dots / legend ----- */
    .dot { width: 11px; height: 11px; border-radius: 3px; display: inline-block; border: 1px solid rgba(0,0,0,.08); }
    .d-std { background: #fff; border-color: #cdd6e6; }
    .d-vip { background: #FFE08A; border-color: #f3c64b; }
    .d-off { background: #cbd5e1; }

    /* ----- Summary ----- */
    .sl-sum-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: .62rem .25rem; border-top: 1px solid #F0F3F8;
    }
    .sl-sum-row > span:first-child { display: inline-flex; align-items: center; gap: .55rem; color: #475569; font-size: .9rem; }
    .sl-sum-total { border-top: none; }
    .sl-sum-total > span:first-child { color: var(--lc-navy); font-weight: 600; }
    .sl-note {
        background: var(--lc-light); border: 1px solid #dbe6ff; border-radius: 10px;
        padding: .7rem .8rem; font-size: .8rem; color: #334155; line-height: 1.45;
    }
</style>
