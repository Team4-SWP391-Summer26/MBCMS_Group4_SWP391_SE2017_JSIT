<%-- Shared seat-layout styles for /branch/seats and /admin/seats - matches the customer booking seat map. --%>
<style>
    /* ----- Screen (same curve as booking) ----- */
    .sl-screen-wrap { margin: 4px 0 26px; }
    .sl-screen-curve {
        height: 26px; margin: 0 auto; max-width: 70%;
        border-top: 3px solid #93b4f6;
        border-radius: 50% / 26px 26px 0 0;
        background: linear-gradient(to bottom, rgba(37,99,235,.14), rgba(37,99,235,0));
    }
    .sl-screen-label { text-align: center; font-size: .68rem; color: var(--lc-muted);
        letter-spacing: .35em; margin-top: 6px; font-weight: 600; }

    /* ----- Grid ----- */
    .sl-grid { display: inline-flex; flex-direction: column; gap: 7px; width: 100%; align-items: center; }
    .sl-row { display: flex; align-items: center; gap: 7px; }
    .sl-rlabel { width: 22px; text-align: center; font-size: .72rem; font-weight: 700; color: var(--lc-muted); flex-shrink: 0; }
    .sl-aisle { width: 26px; flex-shrink: 0; }

    /* ----- Seats (cinema seat shape, like booking) ----- */
    .sl-seat {
        width: 34px; height: 32px; padding: 0; flex-shrink: 0;
        border-radius: 8px 8px 5px 5px; border: 1.6px solid transparent;
        font-size: .6rem; font-weight: 700; cursor: pointer; background: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        transition: transform .08s ease, box-shadow .12s ease, background .12s ease;
    }
    .sl-seat:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,.12); }
    .sl-seat.is-std { background: #f0f7ff; border-color: #7cb0f5; color: #1d4ed8; }
    .sl-seat.is-std:hover { background: #dbeafe; }
    .sl-seat.is-vip { background: #fef3c7; border-color: #f59e0b; color: #92400e; }
    .sl-seat.is-vip:hover { background: #fde68a; }
    .sl-seat.is-off { background: #f3f4f6; border-color: #d1d5db; color: #9ca3af; }
    .sl-seat.selected {
        background: #16a34a; border-color: #15803d; color: #fff;
        box-shadow: 0 4px 12px rgba(22,163,74,.30); transform: translateY(-1px);
    }

    /* ----- Toolbar segmented tools ----- */
    .sl-tools { display: inline-flex; background: #eef1f4; border-radius: 10px; padding: 3px; gap: 2px; }
    .sl-tool {
        border: 0; background: transparent; font-size: .8rem; font-weight: 600;
        color: var(--lc-muted); padding: .32rem .7rem; border-radius: 8px; cursor: pointer;
        display: inline-flex; align-items: center; gap: .4rem; transition: all .12s ease;
    }
    .sl-tool.active { background: #fff; color: var(--lc-navy); box-shadow: 0 1px 2px rgba(15,30,54,.14); }

    /* ----- Legend / summary dots (match seat colors) ----- */
    .dot { width: 12px; height: 12px; border-radius: 3px; display: inline-block; border: 1.5px solid; }
    .d-std { background: #f0f7ff; border-color: #7cb0f5; }
    .d-vip { background: #fef3c7; border-color: #f59e0b; }
    .d-off { background: #f3f4f6; border-color: #d1d5db; }

    /* ----- Summary ----- */
    .sl-sum-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: .62rem .25rem; border-top: 1px solid #F0F3F8;
    }
    .sl-sum-row > span:first-child { display: inline-flex; align-items: center; gap: .55rem; color: #475569; font-size: .9rem; }
    .sl-sum-total { border-top: none; }
    .sl-sum-total > span:first-child { color: var(--lc-navy); font-weight: 600; }
    .sl-note {
        background: var(--lc-light); border: 1px solid #dbe6ff; border-radius: 10px;
        padding: .7rem .8rem; font-size: .8rem; color: #334155; line-height: 1.45;
    }
</style>
